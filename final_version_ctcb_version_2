    "# ============================================================\n",
    "# CELL 9: Compute all metrics on collected raw results\n",
    "# UPGRADED to match Production Architecture (Strict vs UX Output)\n",
    "# ============================================================\n",
    "\n",
    "import json\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "OUTPUT_DIR = Path(\"/kaggle/working/ctcb_comparison\")\n",
    "master_path = OUTPUT_DIR / \"all_raw_results.json\"\n",
    "\n",
    "print(\"Computing all metrics on collected responses...\")\n",
    "print(\"This may take 10-20 minutes for BERTScore.\")\n",
    "\n",
    "# Load raw results\n",
    "if not master_path.exists():\n",
    "    raise FileNotFoundError(f\"Could not find raw results at {master_path}.\")\n",
    "\n",
    "with open(master_path) as f:\n",
    "    all_raw_results = json.load(f)\n",
    "\n",
    "df_raw = pd.DataFrame(all_raw_results)\n",
    "print(f\"Loaded {len(df_raw)} records across {df_raw['model_name'].nunique()} models\")\n",
    "\n",
    "# ── Compute metrics per model ─────────────────────────────────\n",
    "\n",
    "metrics_records = []\n",
    "\n",
    "for model_name in df_raw['model_name'].unique():\n",
    "    print(f\"\\nComputing metrics for: {model_name}\")\n",
    "    \n",
    "    df_model = df_raw[df_raw['model_name'] == model_name].copy()\n",
    "    \n",
    "    # Ensure no None types\n",
    "    df_model = df_model.dropna(subset=['strict_response', 'final_ux_response'])\n",
    "    \n",
    "    if len(df_model) == 0:\n",
    "        print(f\"  Warning: No valid rows for {model_name}. Skipping...\")\n",
    "        continue\n",
    "        \n",
    "    gold_answers   = df_model['gold_answer'].tolist()\n",
    "    target_docs    = df_model['target_document'].tolist()\n",
    "    contams        = df_model['contaminator_doc'].tolist()\n",
    "    \n",
    "    # We evaluate the \"Strict Response\" (The Brain) to prove factual grounding and exact-match\n",
    "    strict_resps = [str(r) if str(r).strip() else \"[EMPTY RESPONSE]\" for r in df_model['strict_response']]\n",
    "    \n",
    "    # We evaluate the \"Final UX Response\" (The Voice) to prove conversational capability\n",
