    "# ============================================================\n",
    "# CELL 7.5: UPGRADE 2 - Asynchronous Vector Database Simulator\n",
    "# Pre-computes and caches all document embeddings to eliminate live latency\n",
    "# ============================================================\n",
    "import time\n",
    "\n",
    "print(\"Starting background document processing...\")\n",
    "start_time = time.time()\n",
    "\n",
    "# This dictionary acts as our lightning-fast, in-memory Vector Database\n",
    "vector_db = {}\n",
    "\n",
    "for session in sessions:\n",
    "    sid = session['session_id']\n",
    "    target_doc = session['target_document']\n",
    "    \n",
    "    # 1. Chunk the document\n",
    "    target_sentences = sent_tokenize(target_doc)\n",
    "    \n",
    "    # 2. Run the heavy BM25 mathematical indexing\n",
    "    bm25_idx = build_bm25_index(target_sentences)\n",
    "    \n",
    "    # 3. Store the finished math in memory\n",
    "    vector_db[sid] = {\n",
    "        \"chunks\": target_sentences,\n",
    "        \"index\": bm25_idx\n",
    "    }\n",
    "\n",
    "elapsed = time.time() - start_time\n",
    "print(f\"Successfully cached {len(vector_db)} documents into memory in {elapsed:.2f} seconds.\")\n",
    "print(\"The system is now ready for zero-latency live queries.\")"
