    "# ── Metric 1: BERTScore F1 ───────────────────────────────────\n",
    "def compute_bertscore(predictions: list, references: list) -> dict:\n",
    "    \"\"\"\n",
    "    Compute BERTScore F1 between predicted responses and gold answers.\n",
    "    BERTScore uses contextual BERT embeddings — captures semantic similarity\n",
    "    better than n-gram overlap metrics.\n",
    "    \n",
    "    Args:\n",
    "        predictions: list of generated response strings\n",
    "        references:  list of gold answer strings (same length)\n",
    "    \n",
    "    Returns:\n",
    "        dict with keys: precision_mean, recall_mean, f1_mean, f1_scores (list)\n",
    "    \"\"\"\n",
    "    if not predictions or not references:\n",
    "        return {\"precision_mean\": 0.0, \"recall_mean\": 0.0, \n",
    "                \"f1_mean\": 0.0, \"f1_scores\": []}\n",
    "    \n",
    "    # bert_score returns tensor lists: P, R, F1 per example\n",
    "    P, R, F1 = bert_score_fn(\n",
    "        predictions,\n",
    "        references,\n",
    "        lang=\"en\",\n",
    "        model_type=\"distilbert-base-uncased\",  # lighter model, faster\n",
    "        device=DEVICE,\n",
    "        verbose=False\n",
    "    )\n",
    "    \n",
    "    return {\n",
    "        \"precision_mean\": float(P.mean()),\n",
    "        \"recall_mean\":    float(R.mean()),\n",
    "        \"f1_mean\":        float(F1.mean()),\n",
    "        \"f1_scores\":      F1.tolist()\n",
    "    }\n",
    "\n",
    "\n",
    "# ── Metric 2: ROUGE Scores ───────────────────────────────────\n",
    "def compute_rouge(predictions: list, references: list) -> dict:\n",
    "    \"\"\"\n",
    "    Compute ROUGE-1, ROUGE-2, ROUGE-L F1 scores.\n",
    "    ROUGE measures n-gram overlap with reference text.\n",
    "    ROUGE-1: unigram overlap | ROUGE-2: bigram | ROUGE-L: longest common subsequence\n",
    "    \n",
    "    Args:\n",
    "        predictions: list of generated response strings\n",
    "        references:  list of gold answer strings\n",
    "    \n",
    "    Returns:\n",
    "        dict with rouge1_f1, rouge2_f1, rougeL_f1 (all means over list)\n",
    "    \"\"\"\n",
    "    scorer = rouge_lib.RougeScorer(\n",
    "        ['rouge1', 'rouge2', 'rougeL'],\n",
    "        use_stemmer=True\n",
    "    )\n",
    "    \n",
    "    r1_scores, r2_scores, rL_scores = [], [], []\n",
    "    \n",
    "    for pred, ref in zip(predictions, references):\n",
    "        if not pred or not ref:\n",
    "            r1_scores.append(0.0)\n",
    "            r2_scores.append(0.0)\n",
    "            rL_scores.append(0.0)\n",
    "            continue\n",
    "        \n",
    "        scores = scorer.score(ref, pred)  # (reference, prediction) order\n",
    "        r1_scores.append(scores['rouge1'].fmeasure)\n",
    "        r2_scores.append(scores['rouge2'].fmeasure)\n",
    "        rL_scores.append(scores['rougeL'].fmeasure)\n",
    "    \n",
    "    return {\n",
    "        \"rouge1_f1\": np.mean(r1_scores),\n",
    "        \"rouge2_f1\": np.mean(r2_scores),\n",
    "        \"rougeL_f1\": np.mean(rL_scores),\n",
    "    }\n",
    "\n",
    "\n",
    "# ── Metric 3: SGI — Semantic Grounding Index ─────────────────\n",
    "def compute_sgi_batch(\n",
    "    responses:         list,\n",
    "    target_documents:  list,\n",
    "    contaminator_docs: list\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Compute SGI for a batch of (response, target_doc, contam_doc) triples.\n",
    "    \n",
    "    SGI = cos_sim(response, target_doc) - cos_sim(response, contaminator_doc)\n",
    "    Positive SGI → response closer to correct document (safe)\n",
    "    Negative SGI → response closer to contaminator (CTCB detected)\n",
    "    \n",
    "    Args:\n",
    "        responses:         list of generated response strings\n",
    "        target_documents:  list of target document strings (correct source)\n",
    "        contaminator_docs: list of contaminator document strings (wrong source)\n",
    "    \n",
    "    Returns:\n",
    "        dict with sgi_mean, sgi_scores (list), ctcb_rate (float 0–1)\n",
    "    \"\"\"\n",
    "    if not responses:\n",
    "        return {\"sgi_mean\": 0.0, \"sgi_scores\": [], \"ctcb_rate\": 0.0}\n",
    "    \n",
    "    # Batch encode all texts at once for efficiency\n",
    "    all_texts = responses + target_documents + contaminator_docs\n",
    "    all_embeddings = SBERT.encode(all_texts, batch_size=32, convert_to_numpy=True)\n",
    "    \n",
    "    n = len(responses)\n",
    "    resp_embs   = all_embeddings[:n]\n",
    "    target_embs = all_embeddings[n:2*n]\n",
    "    contam_embs = all_embeddings[2*n:]\n",
    "    \n",
    "    sgi_scores = []\n",
    "    for r_emb, t_emb, c_emb in zip(resp_embs, target_embs, contam_embs):\n",
    "        # Cosine similarity: dot product of unit vectors\n",
    "        r_norm = r_emb / (np.linalg.norm(r_emb) + 1e-10)\n",
    "        t_norm = t_emb / (np.linalg.norm(t_emb) + 1e-10)\n",
    "        c_norm = c_emb / (np.linalg.norm(c_emb) + 1e-10)\n",
    "        \n",
    "        target_sim = float(np.dot(r_norm, t_norm))\n",
    "        contam_sim = float(np.dot(r_norm, c_norm))\n",
    "        sgi = target_sim - contam_sim\n",
    "        sgi_scores.append(sgi)\n",
    "    \n",
    "    ctcb_detected = [1 if sgi < 0.0 else 0 for sgi in sgi_scores]\n",
    "    \n",
    "    return {\n",
    "        \"sgi_mean\":   np.mean(sgi_scores),\n",
    "        \"sgi_scores\": sgi_scores,\n",
    "        \"ctcb_rate\":  np.mean(ctcb_detected),  # fraction of sessions with SGI < 0\n",
    "    }\n",
