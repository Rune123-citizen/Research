    "# ============================================================\n",
    "# CELL 10: Build final system performance tables & visuals\n",
    "# UPGRADED to match the new Multi-Agent Architecture Metrics\n",
    "# ============================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from tabulate import tabulate\n",
    "\n",
    "df = df_metrics.copy()\n",
    "\n",
    "# ── TABLE 1: System Performance Table ────────────────────────\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"TABLE 1: CORE SYSTEM PERFORMANCE (STRICT FACTUAL GROUNDING)\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "table1_data = []\n",
    "for _, row in df.iterrows():\n",
    "    table1_data.append([\n",
    "        row['model'],\n",
    "        row['family'],\n",
    "        f\"{row['strict_bertscore_f1']:.3f}\",\n",
    "        f\"{row['strict_rouge1_f1']:.3f}\",\n",
    "        f\"{row['strict_ctcb_rate']:.1%}\",\n",
    "        f\"{row['strict_sgi']:.3f}\",\n",
    "        f\"{row['strict_response_len']:.0f} words\",\n",
    "        f\"{row['ux_response_len']:.0f} words\",\n",
    "        f\"{row['tokens_per_sec']}\",\n",
    "        f\"{row['vram_used_gb']} GB\",\n",
    "    ])\n",
    "\n",
    "headers1 = [\n",
    "    \"Model\", \"Family\",\n",
    "    \"BERTScore\", \"ROUGE-1\",\n",
    "    \"CTCB Rate\", \"SGI\",\n",
    "    \"Strict Len\", \"UX Len\",\n",
    "    \"Tok/s\", \"VRAM\"\n",
    "]\n",
    "\n",
    "print(tabulate(table1_data, headers=headers1, tablefmt=\"grid\"))\n",
    "\n",
    "# Save as CSV\n",
    "t1_path = OUTPUT_DIR / \"table1_system_performance.csv\"\n",
    "pd.DataFrame(table1_data, columns=headers1).to_csv(t1_path, index=False)\n",
    "\n",
    "\n",
    "# ── TABLE 2: Session Length Breakdown ────────────────────────\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"TABLE 2: PERFORMANCE vs SESSION LENGTH\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Load per-session raw data to group by n_prior_turns\n",
    "df_raw_loaded = pd.DataFrame(all_raw_results)\n",
    "df_raw_loaded = df_raw_loaded.dropna(subset=['strict_response'])\n",
    "\n",
    "n_prior_groups = sorted(df_raw_loaded['n_prior_turns'].unique())\n",
    "table2_data    = []\n",
    "\n",
    "for n in n_prior_groups:\n",
    "    df_n   = df_raw_loaded[df_raw_loaded['n_prior_turns'] == n]\n",
    "    \n",
    "    # Average across all models for this n_prior\n",
    "    strict_resps = df_n['strict_response'].tolist()\n",
    "    golds    = df_n['gold_answer'].tolist()\n",
    "    targets  = df_n['target_document'].tolist()\n",
    "    contams  = df_n['contaminator_doc'].tolist()\n",
    "    \n",
    "    strict_sgi_r = compute_sgi_batch(strict_resps, targets, contams)\n",
    "    strict_r     = compute_rouge(strict_resps, golds)\n",
    "    \n",
    "    table2_data.append([\n",
    "        n,\n",
    "        len(df_n),\n",
    "        f\"{strict_r['rouge1_f1']:.3f}\",\n",
    "        f\"{strict_sgi_r['ctcb_rate']:.1%}\",\n",
    "        f\"{strict_sgi_r['sgi_mean']:.3f}\",\n",
    "    ])\n",
    "\n",
    "headers2 = [\"N Prior Turns\", \"Sessions\", \"ROUGE-1\", \"CTCB-Rate\", \"SGI Mean\"]\n",
    "\n",
    "print(tabulate(table2_data, headers=headers2, tablefmt=\"grid\"))\n",
    "t2_path = OUTPUT_DIR / \"table2_session_length.csv\"\n",
    "pd.DataFrame(table2_data, columns=headers2).to_csv(t2_path, index=False)\n",
    "\n",
    "\n",
    "# ── VISUALISATION 1: CTCB-Rate & BERTScore Bar Chart ──────────\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "fig.suptitle(\"Core System: Factual Grounding & Correctness\",\n",
    "             fontsize=14, fontweight='bold')\n",
    "\n",
    "x        = np.arange(len(df))\n",
    "width    = 0.45\n",
    "colors_a = \"#2E8B57\"  # green\n",
    "\n",
    "axes[0].bar(x, df['strict_ctcb_rate'] * 100, width,\n",
    "            label='System CTCB Rate', color=colors_a, alpha=0.85)\n",
    "\n",
    "axes[0].set_xlabel(\"Model\")\n",
    "axes[0].set_ylabel(\"CTCB Detection Rate (%)\")\n",
    "axes[0].set_title(\"CTCB Rate (Lower is Better)\")\n",
    "axes[0].set_xticks(x)\n",
    "axes[0].set_xticklabels(\n",
    "    [m.split()[0] for m in df['model']],\n",
    "    rotation=30, ha='right', fontsize=9\n",
    ")\n",
    "axes[0].axhline(y=5, color='red', linestyle='--', alpha=0.5, label='5% threshold')\n",
    "axes[0].legend()\n",
    "axes[0].set_ylim(0, 100)\n",
    "\n",
    "axes[1].bar(x, df['strict_bertscore_f1'], width,\n",
    "            label='BERTScore', color=\"#4169E1\", alpha=0.85)\n",
    "\n",
    "axes[1].set_xlabel(\"Model\")\n",
    "axes[1].set_ylabel(\"BERTScore F1\")\n",
    "axes[1].set_title(\"Answer Correctness (Higher is Better)\")\n",
    "axes[1].set_xticks(x)\n",
    "axes[1].set_xticklabels(\n",
    "    [m.split()[0] for m in df['model']],\n",
    "    rotation=30, ha='right', fontsize=9\n",
    ")\n",
    "axes[1].legend()\n",
    "axes[1].set_ylim(0, 1)\n",
    "\n",
    "plt.tight_layout()\n",
    "fig.savefig(OUTPUT_DIR / \"figure1_system_performance.png\", dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Figure 1 saved.\")\n",
    "\n",
    "\n",
    "# ── FINAL SUMMARY ────────────────────────────────────────────\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"FINAL SUMMARY: SYSTEM METRICS\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "summary_cols = [\n",
    "    \"model\", \"strict_ctcb_rate\", \"strict_bertscore_f1\", \n",
    "    \"strict_rouge1_f1\", \"tokens_per_sec\"\n",
    "]\n",
    "df_summary = df[summary_cols].copy()\n",
    "df_summary.columns = [\n",
    "    \"Model\", \"CTCB Rate\", \"BERTScore F1\", \"ROUGE-1 F1\", \"Tok/s\"\n",
    "]\n",
    "\n",
    "df_summary[\"CTCB Rate\"] = df_summary[\"CTCB Rate\"].apply(lambda x: f\"{x:.1%}\")\n",
    "\n",
    "print(tabulate(df_summary, headers='keys', tablefmt=\"grid\", showindex=False))\n",
    "df_summary.to_csv(OUTPUT_DIR / \"final_summary.csv\", index=False)\n",
    "\n",
    "print(f\"\\nAll outputs saved to: {OUTPUT_DIR}\")"
   ]
