    "# ============================================================\n",
    "\n",
    "import shutil\n",
    "import json\n",
    "import os\n",
    "import time\n",
    "\n",
    "print(\"Performing pre-flight GPU memory sweep...\")\n",
    "clear_gpu_memory()\n",
    "print(\"GPU ready.\")\n",
    "\n",
    "# -- 1. REGISTRY (Mini-Test Version) ---------------------------------\n",
    "MODEL_REGISTRY = [\n",
    "    {\n",
    "        \"name\":              \"Qwen2.5 7B Instruct\",\n",
    "        \"model_id\":          \"Qwen/Qwen2.5-7B-Instruct\",\n",
    "        \"use_4bit\":          True,\n",
    "        \"trust_remote_code\": False,\n",
    "        \"family\":            \"Alibaba Qwen\",\n",
    "        \"prompt_style\":      \"qwen\",\n",
    "    }\n",
    "]\n",
    "   \n",
    "   \n",
    "\n",
    "SPEED_TEST_PROMPT = (\n",
    "    \"Here is a document about graph neural networks. \"\n",
    "    \"GNNs aggregate features from neighbouring nodes through message passing. \"\n",
    "    \"Question: What is the message passing mechanism? \"\n",
    "    \"Answer:\"\n",
    ")\n",
    "\n",
    "# -- 2. EVALUATION FUNCTION ----------------------------------------\n",
    "\n",
    "def evaluate_model(model_info: dict, sessions: list) -> list:\n",
    "    model_name   = model_info[\"name\"]\n",
    "    model_id     = model_info[\"model_id\"]\n",
    "    use_4bit     = model_info[\"use_4bit\"]\n",
    "    trust_rc     = model_info[\"trust_remote_code\"]\n",
    "    prompt_style = model_info.get(\"prompt_style\", \"default\")\n",
    "    \n",
    "    sep = \"=\" * 60\n",
    "    print(f\"\\n{sep}\")\n",
    "    print(f\"Evaluating: {model_name}  (prompt_style={prompt_style})\")\n",
    "    print(f\"{sep}\")\n",
    "    \n",
    "    try:\n",
    "        model, tokenizer = load_model(model_id, use_4bit=use_4bit, trust_remote_code=trust_rc)\n",
    "    except Exception as e:\n",
    "        print(f\"FAILED to load {model_name}: {e}\")\n",
    "        return []\n",
    "    \n",
    "    speed_metrics = measure_inference_speed(model, tokenizer, SPEED_TEST_PROMPT)\n",
    "    print(f\"  Speed: {speed_metrics['tokens_per_sec']} tok/s | VRAM: {speed_metrics['vram_used_gb']} GB\")\n",
    "    \n",
    "    results = []\n",
    "    \n",
    "    for i, session in enumerate(sessions):\n",
    "        if i % 20 == 0:\n",
    "            print(f\"  Progress: {i}/{len(sessions)} sessions...\")\n",
    "        \n",
    "        session_id    = session['session_id']\n",
    "        n_prior       = session['n_prior_turns']\n",
    "        domain_pair   = session['domain_pair']\n",
    "        target_doc    = session['target_document']\n",
    "        gold_answer   = session['gold_answer']\n",
    "        \n",
    "        # Contaminator document: concatenation of prior turn contexts\n",
    "        contam_doc = \" \".join([turn['context'] for turn in session['prior_turns']]) if session['prior_turns'] else target_doc \n",
    "\n",
    "        # ==========================================\n",
    "        # UPGRADE 1: CONTEXT-AWARE DYNAMIC ROUTING\n",
    "        # ==========================================\n",
    "        try:\n",
    "            # If the chat history is short, bypass the heavy pipeline \n",
    "            # and use standard generation to avoid truncation errors.\n",
    "            if n_prior < 5:\n",
    "                production_prompt = build_baseline_prompt(session, tokenizer)\n",
    "                strict_response = generate_response(model, tokenizer, production_prompt)\n",
    "                routing_path_taken = \"Baseline Bypass\"\n",
    "                final_ux_response = strict_response # No translation needed for baseline\n",
    "                \n",
    "            # If the chat history is long, deploy the QA-CAP shield \n",
    "            # to prevent Cross-Topic Context Bias.\n",
    "            else:\n",
    "                cached_data = vector_db[session_id]\n",
    "                target_sentences = cached_data[\"chunks\"]\n",
    "                bm25_idx         = cached_data[\"index\"]\n",
    "                retrieved_chunks = retrieve_top_k(session['target_query'], target_sentences, bm25_idx, top_k=8)\n",
    "                production_prompt = build_qacap_prompt(session, retrieved_chunks, tokenizer, prompt_style=prompt_style)\n",
    "\n",
    "                # PASS 1: The Brain (Strict, factual, hallucination-free)\n",
    "                strict_response = generate_response(model, tokenizer, production_prompt)\n",
    "                routing_path_taken = \"QA-CAP Pipeline\"\n",
    "\n",
    "                # ==========================================\n",
    "                # UPGRADE 4: TWO-PASS TONE TRANSLATOR\n",
    "                # ==========================================\n",
    "                tone_sys_msg = (\n",
    "                    \"You are a friendly, conversational assistant. \"\n",
    "                    \"Rewrite the following factual text to sound warm and natural. \"\n",
    "                    \"CRITICAL REQUIREMENT: You MUST keep all facts and retain all citation tags \"\n",
    "                    \"(e.g., [C1], [1]) exactly as they appear. Do not add outside knowledge.\"\n",
    "                )\n",
    "                tone_user_msg = f\"Strict Factual Text:\\n{strict_response}\"\n",
