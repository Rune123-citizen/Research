    "# ============================================================\n",
    "# CELL 1: Install dependencies\n",
    "# Run this cell first. Restart runtime after completion.\n",
    "# ============================================================\n",
    "\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "def install(package):\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", package])\n",
    "\n",
    "# Core ML libraries (most pre-installed on Kaggle, but pin versions)\n",
    "install(\"transformers>=4.44.0\")\n",
    "install(\"accelerate>=0.30.0\")\n",
    "install(\"bitsandbytes>=0.43.0\")        # 4-bit quantisation\n",
    "install(\"sentencepiece>=0.2.0\")        # tokenizer for some models\n",
    "install(\"protobuf>=3.20.0\")            # required by some tokenizers\n",
    "\n",
    "# Evaluation metrics\n",
    "install(\"evaluate>=0.4.0\")             # HuggingFace evaluate library\n",
    "install(\"rouge-score>=0.1.2\")          # ROUGE-1, ROUGE-2, ROUGE-L\n",
    "install(\"bert-score>=0.3.13\")          # BERTScore semantic similarity\n",
    "install(\"sacrebleu>=2.4.0\")            # BLEU score\n",
    "\n",
    "# NLP utilities\n",
    "install(\"nltk>=3.8.1\")\n",
    "install(\"sentence-transformers>=2.7.0\")  # SBERT for SGI computation\n",
    "\n",
    "# Data handling\n",
    "install(\"datasets>=2.20.0\")            # HuggingFace datasets\n",
    "install(\"pandas>=2.0.0\")\n",
    "install(\"numpy>=1.24.0\")\n",
    "\n",
    "# Visualisation\n",
    "install(\"matplotlib>=3.8.0\")\n",
    "install(\"seaborn>=0.13.0\")\n",
    "install(\"tabulate>=0.9.0\")             # Pretty-print comparison tables\n",
    "\n",
    "# CTCB-specific\n",
    "install(\"rank_bm25>=0.2.2\")            # BM25 retrieval for QA-CAP Stage 3\n",
    "install(\"faiss-cpu>=1.8.0\")            # Dense retrieval fallback\n",
    "\n",
    "print(\"All libraries installed successfully.\")\n",
    "print(\"If you see CUDA errors below, restart the Kaggle runtime now.\")"
