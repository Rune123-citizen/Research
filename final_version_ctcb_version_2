    "# ============================================================\n",
    "# CELL 4: Build CTCB-Bench dataset\n",
    "# 100 multi-topic sessions across near-neighbor domain pairs\n",
    "# ============================================================\n",
    "\n",
    "print(\"Loading source datasets...\")\n",
    "\n",
    "# ── Load five domain datasets ────────────────────────────────\n",
    "\n",
    "# Medical: MedMCQA\n",
    "medical = load_dataset(\n",
    "    \"medmcqa\",\n",
    "    split=\"validation\",\n",
    "    cache_dir=str(CACHE_DIR)\n",
    ").select(range(300))\n",
    "\n",
    "# Science: AI2-ARC Challenge\n",
    "science = load_dataset(\n",
    "    \"ai2_arc\",\n",
    "    \"ARC-Challenge\",\n",
    "    split=\"test\",\n",
    "    cache_dir=str(CACHE_DIR)\n",
    ").select(range(300))\n",
    "\n",
    "# Biology: SQuAD\n",
    "biology = load_dataset(\n",
    "    \"squad\",\n",
    "    split=\"validation\",\n",
    "    cache_dir=str(CACHE_DIR)\n",
    ").select(range(300))\n",
    "\n",
    "# Math: GSM8K\n",
    "math_ds = load_dataset(\n",
    "    \"gsm8k\",\n",
    "    \"main\",\n",
    "    split=\"test\",\n",
    "    cache_dir=str(CACHE_DIR)\n",
    ").select(range(300))\n",
    "\n",
    "# Coding: OpenAI HumanEval\n",
    "coding_ds = load_dataset(\n",
    "    \"openai_humaneval\",\n",
    "    split=\"test\",\n",
    "    cache_dir=str(CACHE_DIR)\n",
    ").select(range(164))\n",
    "\n",
    "print(\"Datasets loaded.\")\n",
    "\n",
    "# ── Helper: extract (question, context, answer) per domain ──\n",
    "\n",
    "def extract_medmcqa(example):\n",
    "    \"\"\"Extract QA triple from MedMCQA format.\"\"\"\n",
    "    options = {\n",
    "        'a': example.get('opa', ''),\n",
    "        'b': example.get('opb', ''),\n",
    "        'c': example.get('opc', ''),\n",
    "        'd': example.get('opd', '')\n",
    "    }\n",
    "    correct_key = ['a', 'b', 'c', 'd'][example.get('cop', 0)]\n",
    "    return {\n",
    "        \"question\": example.get('question', ''),\n",
    "        \"context\":  example.get('exp', example.get('question', '')),\n",
    "        \"answer\":   options.get(correct_key, '')\n",
    "    }\n",
    "\n",
    "def extract_arc(example):\n",
    "    \"\"\"Extract QA triple from AI2-ARC format.\"\"\"\n",
    "    choices = example['choices']\n",
    "    labels  = choices['label']\n",
    "    texts   = choices['text']\n",
    "    answer_key = example['answerKey']\n",
    "    answer_text = ''\n",
    "    for label, text in zip(labels, texts):\n",
    "        if label == answer_key:\n",
    "            answer_text = text\n",
    "            break\n",
    "    return {\n",
    "        \"question\": example['question'],\n",
    "        \"context\":  example['question'],\n",
    "        \"answer\":   answer_text\n",
    "    }\n",
    "\n",
    "def extract_squad(example):\n",
    "    \"\"\"Extract QA triple from SQuAD format.\"\"\"\n",
    "    answers = example.get('answers', {})\n",
    "    answer_text = answers.get('text', [''])[0] if answers.get('text') else ''\n",
    "    return {\n",
    "        \"question\": example['question'],\n",
    "        \"context\":  example['context'],\n",
    "        \"answer\":   answer_text\n",
    "    }\n",
    "\n",
    "def extract_gsm8k(example):\n",
    "    \"\"\"Extract QA triple from GSM8K format.\"\"\"\n",
    "    ans_text = example['answer']\n",
    "    # GSM8K usually separates the chain-of-thought from the final answer with '####'\n",
    "    if '####' in ans_text:\n",
    "        answer = ans_text.split('####')[-1].strip()\n",
    "    else:\n",
    "        answer = ans_text\n",
    "    return {\n",
    "        \"question\": example['question'],\n",
    "        \"context\":  example['question'], # GSM8K does not have a separate context\n",
    "        \"answer\":   answer\n",
    "    }\n",
    "\n",
    "def extract_humaneval(example):\n",
    "    \"\"\"Extract QA triple from HumanEval format.\"\"\"\n",
    "    return {\n",
    "        \"question\": example['prompt'],\n",
    "        \"context\":  example['prompt'], # Code completion doesn't have a separate context\n",
    "        \"answer\":   example['canonical_solution']\n",
    "    }\n",
    "\n",
    "# ── Extract all examples ─────────────────────────────────────\n",
    "\n",
    "domains = {\n",
    "    \"medical\": [extract_medmcqa(ex)   for ex in medical],\n",
    "    \"science\": [extract_arc(ex)       for ex in science],\n",
    "    \"biology\": [extract_squad(ex)     for ex in biology],\n",
    "    \"math\":    [extract_gsm8k(ex)     for ex in math_ds],\n",
    "    \"coding\":  [extract_humaneval(ex) for ex in coding_ds],\n",
    "}\n",
    "\n",
    "# Filter out empty examples\n",
    "for domain in domains:\n",
    "    domains[domain] = [\n",
    "        ex for ex in domains[domain]\n",
    "        if ex['question'] and ex['answer'] and ex['context']\n",
    "    ]\n",
    "    print(f\"  {domain}: {len(domains[domain])} valid examples\")\n",
    "\n",
    "# ── Build CTCB-Bench sessions ────────────────────────────────\n",
    "\n",
    "domain_names = list(domains.keys())\n",
    "sessions = []\n",
    "session_id = 0\n",
    "\n",
    "random.seed(SEED)\n",
    "\n",
    "# Generate sessions: near-neighbor domain pairs, varied prior turn counts\n",
    "for n_prior in N_PRIOR_TURNS:\n",
    "    for _ in range(N_SESSIONS // len(N_PRIOR_TURNS)):\n",
    "        \n",
    "        # Pick contaminator and target domains using Hard-Mode pairings\n",
    "        contam_domain, target_domain = random.choice(NEAR_NEIGHBOR_PAIRS)\n",
    "        \n",
    "        # Sample prior turns from contaminator domain\n",
    "        prior_examples = random.sample(\n",
    "            domains[contam_domain],\n",
    "            min(n_prior, len(domains[contam_domain]))\n",
    "        )\n",
    "        prior_turns = [\n",
    "            {\"question\": ex[\"question\"], \"context\": ex[\"context\"], \"answer\": ex[\"answer\"]}\n",
    "            for ex in prior_examples\n",
    "        ]\n",
    "        \n",
    "        # Sample target example\n",
    "        target_ex = random.choice(domains[target_domain])\n",
    "        \n",
    "        sessions.append({\n",
    "            \"session_id\":          session_id,\n",
    "            \"n_prior_turns\":       n_prior,\n",
    "            \"contaminator_domain\": contam_domain,\n",
    "            \"target_domain\":       target_domain,\n",
    "            \"domain_pair\":         f\"{contam_domain}->{target_domain}\",\n",
    "            \"prior_turns\":         prior_turns,\n",
    "            \"target_document\":     target_ex[\"context\"],\n",
    "            \"target_query\":        target_ex[\"question\"],\n",
    "            \"gold_answer\":         target_ex[\"answer\"],\n",
    "        })\n",
    "        session_id += 1\n",
    "\n",
    "print(f\"\\nBuilt {len(sessions)} CTCB-Bench sessions\")\n",
    "print(f\"Domain pair distribution:\")\n",
    "df_temp = pd.DataFrame(sessions)\n",
    "print(df_temp.groupby(['contaminator_domain', 'target_domain']).size().to_string())\n",
    "\n",
    "# Save to disk\n",
    "sessions_path = OUTPUT_DIR / \"ctcb_bench_sessions.json\"\n",
    "with open(sessions_path, 'w') as f:\n",
    "    json.dump(sessions, f, indent=2)\n",
    "print(f\"\\nSessions saved to {sessions_path}\")"
   ]
