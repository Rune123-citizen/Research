    "        \"role\": \"system\",\n",
    "        \"content\": \"You are a helpful assistant. Answer questions accurately, comprehensively, and fluently.\"\n",
    "    })\n",
    "    \n",
    "    for i, turn in enumerate(session['prior_turns']):\n",
    "        messages.append({\"role\": \"user\",      \"content\": turn['question']})\n",
    "        messages.append({\"role\": \"assistant\", \"content\": turn['answer']})\n",
    "    \n",
    "    current_user_msg = (\n",
    "        f\"Here is a document for you to read:\\n\\n\"\n",
    "        f\"{session['target_document']}\\n\\n\"\n",
    "        f\"Question: {session['target_query']}\\n\\n\"\n",
    "        f\"Please answer comprehensively based on the document above.\"\n",
    "    )\n",
    "    messages.append({\"role\": \"user\", \"content\": current_user_msg})\n",
    "    \n",
    "    try:\n",
    "        prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
    "    except Exception:\n",
    "        prompt = \"\"\n",
    "        for msg in messages:\n",
    "            prompt += f\"\\n{msg['role'].upper()}: {msg['content']}\"\n",
    "        prompt += \"\\nASSISTANT:\"\n",
    "    return prompt\n",
    "\n",
    "\n",
    "def build_qacap_prompt(session: dict, retrieved_chunks: list, tokenizer, prompt_style: str = \"default\") -> str:\n",
    "    # Use standard brackets [1] instead of <C1> so Gemma doesn't confuse them with system tokens\n",
    "    numbered_context = \"\"\n",
    "    for chunk_text, anchor_idx in retrieved_chunks:\n",
    "        numbered_context += f\"[{anchor_idx}] {chunk_text}\\n\\n\"\n",
    "\n",
    "\n",
    "    # =====================================================================\n",
    "    # UPGRADE 3: DOMAIN-ADAPTIVE PROMPT SWITCHING\n",
    "    # Dynamically toggle verbosity to protect Exact-Match (ROUGE) scores\n",
    "    # =====================================================================\n",
    "    target_domain = session.get('target_domain', 'general')\n",
    "\n",
    "    if target_domain in ['math', 'coding']:\n",
    "        behavior_instruction = (\n",
    "            \"Output ONLY the final formula, mathematical answer, or code block. \"\n",
    "            \"Be extremely concise. Do not write conversational filler or explanations.\"\n",
    "        )\n",
    "    else:\n",
    "        behavior_instruction = (\n",
    "            \"Write a fluent, comprehensive, and natural-sounding paragraph.\"\n",
    "        )\n",
    "\n",
    "    \n",
    "    # SOTA Prompting: We explicitly demand \"fluent, comprehensive paragraphs\" to boost BERTScore\n",
    "    if prompt_style == \"gemma\":\n",
    "        system_msg = (\n",
    "            \"You are a precise research assistant. \"\n",
    "            \"Answer the question using ONLY the provided document passages below. \"\n",
    "            \"Write a fluent, comprehensive, and natural-sounding paragraph. \"\n",
    "            \"Reference passage numbers like [1] or [2] when you use them.\"\n",
    "        )\n",
    "    elif prompt_style == \"qwen\":\n",
    "        system_msg = (\n",
    "            \"You are a factual question answering assistant. \"\n",
    "            \"You will receive numbered reference passages and a question. \"\n",
    "            \"Answer ONLY using information from the passages. \"\n",
    "            \"Write your answer as a fluent, detailed paragraph. \"\n",
    "            \"Format: Answer: [your fluent answer] | Source: [passage numbers used]\"\n",
    "        )\n",
    "    elif prompt_style == \"llama\":\n",
    "        system_msg = (\n",
    "            \"You are a grounded question answering assistant. \"\n",
    "            \"Read the provided context passages carefully. \"\n",
    "            \"Answer the question comprehensively and fluently using ONLY information from these passages. \"\n",
    "            \"Do not add outside knowledge, but ensure your answer flows naturally.\"\n",
    "        )\n",
    "    else:\n",
    "        system_msg = (\n",
    "            \"You are a precise document analyst. Answer the question using \"\n",
    "            \"ONLY the provided document passages below. Write a fluent, detailed paragraph. \"\n",
    "            \"For every factual statement you make, cite the supporting passage \"\n",
    "            \"in this format: [TARGET:C_START-C_END]. \"\n",
    "            \"If no chunk supports a claim, write [UNVERIFIED].\"\n",
    "        )\n",
    "\n",
    "    user_msg = (\n",
    "        f\"Document passages:\\n{numbered_context}\\n\"\n",
    "        f\"Question: {session['target_query']}\\n\"\n",
    "    )\n",
    "\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": system_msg},\n",
    "        {\"role\": \"user\",   \"content\": user_msg}\n",
    "    ]\n",
    "    \n",
    "    try:\n",
    "        prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
    "    except Exception:\n",
    "        prompt = f\"SYSTEM: {system_msg}\\n\\nUSER: {user_msg}\\n\\nASSISTANT:\"\n",
    "    return prompt\n",
    "\n",
    "\n",
    "def build_bm25_index(sentences: list) -> BM25Okapi:\n",
    "    tokenized = [word_tokenize(sent.lower()) for sent in sentences]\n",
    "    return BM25Okapi(tokenized)\n",
    "\n",
    "\n",
    "def retrieve_top_k(query: str, sentences: list, bm25_idx: BM25Okapi, top_k: int = 8) -> list:\n",
    "    \"\"\"\n",
    "    SOTA Hybrid Retrieval with Sentence Boundary Expansion & Contiguous Merging.\n",
    "    Fixes the BERTScore drop by providing LLMs with cohesive paragraphs instead of fragmented sentences.\n",
    "    \"\"\"\n",
    "    if not sentences:\n",
    "        return []\n",
    "    n = len(sentences)\n",
    "\n",
    "    # 1. Hybrid Scoring (BM25 + SBERT)\n",
    "    query_tokens = word_tokenize(query.lower())\n",
    "    bm25_scores  = bm25_idx.get_scores(query_tokens)\n",
    "    bm25_order   = np.argsort(bm25_scores)[::-1]\n",
    "    bm25_rank    = {idx: rank for rank, idx in enumerate(bm25_order)}\n",
    "\n",
    "    q_emb   = SBERT.encode(query, convert_to_numpy=True)\n",
    "    s_embs  = SBERT.encode(sentences, convert_to_numpy=True, batch_size=64)\n",
    "    q_norm  = q_emb / (np.linalg.norm(q_emb) + 1e-10)\n",
    "    s_norms = s_embs / (np.linalg.norm(s_embs, axis=1, keepdims=True) + 1e-10)\n",
    "    dense_scores = s_norms @ q_norm\n",
    "    dense_order  = np.argsort(dense_scores)[::-1]\n",
    "    dense_rank   = {idx: rank for rank, idx in enumerate(dense_order)}\n",
    "\n",
    "    combined_rank = [bm25_rank[i] + dense_rank[i] for i in range(n)]\n",
    "    top_indices   = np.argsort(combined_rank)[:top_k].tolist()\n",
    "\n",
    "    # 2. SOTA Context Expansion (The LongCite Technique)\n",
    "    # Expand the winning sentences by +/- 1 sentence to capture surrounding narrative context\n",
    "    expanded_indices = set()\n",
    "    for idx in top_indices:\n",
    "        if idx > 0: expanded_indices.add(idx - 1)\n",
    "        expanded_indices.add(idx)\n",
    "        if idx < n - 1: expanded_indices.add(idx + 1)\n",
    "        \n",
    "    expanded_list = sorted(list(expanded_indices))\n",
    "\n",
    "    # 3. Contiguous Chunk Merging\n",
    "    # Combine adjacent sentences into fluid paragraphs so the LLM reads naturally\n",
    "    chunks = []\n",
    "    if not expanded_list:\n",
    "        return []\n",
    "\n",
    "    current_chunk_sents = [sentences[expanded_list[0]]]\n",
    "    current_anchor = expanded_list[0]\n",
    "\n",
    "    for j in range(1, len(expanded_list)):\n",
    "        prev_idx = expanded_list[j-1]\n",
    "        curr_idx = expanded_list[j]\n",
    "        \n",
    "        if curr_idx == prev_idx + 1:\n",
    "            # Sentences are next to each other in the document; merge them!\n",
    "            current_chunk_sents.append(sentences[curr_idx])\n",
    "        else:\n",
    "            # Gap found; save the completed paragraph and start a new one\n",
    "            chunks.append((\" \".join(current_chunk_sents), current_anchor))\n",
    "            current_chunk_sents = [sentences[curr_idx]]\n",
    "            current_anchor = curr_idx\n",
    "            \n",
    "    # Save the final paragraph\n",
    "    if current_chunk_sents:\n",
    "        chunks.append((\" \".join(current_chunk_sents), current_anchor))\n",
    "\n",
    "    return chunks"
   ]
