    "CACHE_DIR = Path(\"/kaggle/working/model_cache\")\n",
    "CACHE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Evaluation config\n",
    "MAX_NEW_TOKENS = 256        # Max tokens generated per response\n",
