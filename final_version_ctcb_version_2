    "    contam_embs = SBERT.encode(contaminator_docs, convert_to_numpy=True)\n",
    "    \n",
    "    severity_scores = []\n",
    "    for r_emb, c_emb in zip(resp_embs, contam_embs):\n",
    "        r_norm = r_emb / (np.linalg.norm(r_emb) + 1e-10)\n",
    "        c_norm = c_emb / (np.linalg.norm(c_emb) + 1e-10)\n",
    "        severity = float(np.dot(r_norm, c_norm))\n",
    "        severity_scores.append(severity)\n",
    "    \n",
    "    return {\n",
    "        \"severity_mean\":   np.mean(severity_scores),\n",
    "        \"severity_scores\": severity_scores,\n",
    "    }\n",
