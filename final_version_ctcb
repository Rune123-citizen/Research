ED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\nOUTPUT_DIR = Path(\"/kaggle/working/ctcb_comparison\")\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\nCACHE_DIR = Path(\"/kaggle/working/model_cache\")\nCACHE_DIR.mkdir(parents=True, exist_ok=True)\n\n# Evaluation config\nMAX_NEW_TOKENS = 256        # Max tokens generated per response\nTEMPERATURE    = 0.0        # Deterministic generation (greedy)\nTOP_P          = 1.0        # No nucleus sampling at temp=0\nN_SESSIONS     = 100        # Sessions per model (increase to 500 for full benchmark)\nN_PRIOR_TURNS  = [0, 20, 50, 100] # Prior contaminator turns to test\n\nNEAR_NEIGHBOR_PAIRS = [\n    (\"medical\", \"biology\"),\n    (\"biology\", \"medical\"),\n    (\"biology\", \"science\"),\n    (\"science\", \"biology\"),\n    (\"coding\", \"math\"),\n    (\"math\", \"coding\"),\n    (\"science\", \"math\")\n]\n\n# Device\nDEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nDTYPE  = torch.float16 if torch.cuda.is_available() else torch.float32\n\nprint(f\"\\nConfiguration:\")\nprint(f\"  Device:      {DEVICE}\")\nprint(f\"  Dtype:       {DTYPE}\")\nprint(f\"  Output dir:  {OUTPUT_DIR}\")\nprint(f\"  N sessions:  {N_SESSIONS}\")\nprint(f\"  Prior Turns: {N_PRIOR_TURNS}\")\nprint(f\"  Seed:        {SEED}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T04:24:21.135672Z","iopub.execute_input":"2026-06-17T04:24:21.136652Z","iopub.status.idle":"2026-06-17T04:24:51.600749Z","shell.execute_reply.started":"2026-06-17T04:24:21.136601Z","shell.execute_reply":"2026-06-17T04:24:51.59997Z"}},"outputs":[{"name":"stdout","text":"PyTorch version: 2.10.0+cu128\nCUDA available: True\nGPU: Tesla T4\nTotal VRAM: 15.6 GB\n\nConfiguration:\n  Device:      cuda\n  Dtype:       torch.float16\n  Output dir:  /kaggle/working/ctcb_comparison\n  N sessions:  100\n  Prior Turns: [0, 20, 50, 100]\n  Seed:        42\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# ============================================================\n# CELL 3: HuggingFace authentication\n# Required for Llama 3.1 and Gemma 2 (gated models)\n# ============================================================\n\n# Method: Add HF_TOKEN to Kaggle Secrets\n# Kaggle sidebar -> Add-ons -> Secrets -> Add Secret\n# Key: HF_TOKEN   Value: your HuggingFace token from hf.co/settings/tokens\n\ntry:\n    from kaggle_secrets import UserSecretsClient\n    secrets = UserSecretsClient()\n    HF_TOKEN = secrets.get_secret(\"HF_TOKEN\")\n    os.environ[\"HF_TOKEN\"] = HF_TOKEN\n    \n    # Login to HuggingFace\n    from huggingface_hub import login\n    login(token=HF_TOKEN, add_to_git_credential=False)\n    print(\"HuggingFace login successful.\")\n    \nexcept Exception as e:\n    print(f\"HF Token not found in secrets: {e}\")\n    print(\"Non-gated models (Mistral, Phi-3, Qwen, Falcon) will still work.\")\n    print(\"For Llama 3.1 and Gemma 2: add HF_TOKEN to Kaggle Secrets.\")\n    HF_TOKEN = None","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T04:24:56.085969Z","iopub.execute_input":"2026-06-17T04:24:56.08659Z","iopub.status.idle":"2026-06-17T04:24:56.402982Z","shell.execute_reply.started":"2026-06-17T04:24:56.086557Z","shell.execute_reply":"2026-06-17T04:24:56.402323Z"}},"outputs":[{"name":"stderr","text":"Note: Environment variable`HF_TOKEN` is set and is the current active token independently from the token you've just configured.\n","output_type":"stream"},{"name":"stdout","text":"HuggingFace login successful.\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# ============================================================\n# CELL 4: Build CTCB-Bench dataset\n# 100 multi-topic sessions across near-neighbor domain pairs\n# ============================================================\n\nprint(\"Loading source datasets...\")\n\n# ── Load five domain datasets ────────────────────────────────\n\n# Medical: MedMCQA\nmedical = load_dataset(\n    \"medmcqa\",\n    split=\"validation\",\n    cache_dir=str(CACHE_DIR)\n).select(range(300))\n\n# Science: AI2-ARC Challenge\nscience = load_dataset(\n    \"ai2_arc\",\n    \"ARC-Challenge\",\n    split=\"test\",\n    cache_dir=str(CACHE_DIR)\n).select(range(300))\n\n# Biology: SQuAD\nbiology = load_dataset(\n    \"squad\",\n    split=\"validation\",\n    cache_dir=str(CACHE_DIR)\n).select(range(300))\n\n# Math: GSM8K\nmath_ds = load_dataset(\n    \"gsm8k\",\n    \"main\",\n    split=\"test\",\n    cache_dir=str(CACHE_DIR)\n).select(range(300))\n\n# Coding: OpenAI HumanEval\ncoding_ds = load_dataset(\n    \"openai_humaneval\",\n    split=\"test\",\n    cache_dir=str(CACHE_DIR)\n).select(range(164))\n\nprint(\"Datasets loaded.\")\n\n# ── Helper: extract (question, context, answer) per domain ──\n\ndef extract_medmcqa(example):\n    \"\"\"Extract QA triple from MedMCQA format.\"\"\"\n    options = {\n        'a': example.get('opa', ''),\n        'b': example.get('opb', ''),\n        'c': example.get('opc', ''),\n        'd': example.get('opd', '')\n    }\n    correct_key = ['a', 'b', 'c', 'd'][example.get('cop', 0)]\n    return {\n        \"question\": example.get('question', ''),\n        \"context\":  example.get('exp', example.get('question', '')),\n        \"answer\":   options.get(correct_key, '')\n    }\n\ndef extract_arc(example):\n    \"\"\"Extract QA triple from AI2-ARC format.\"\"\"\n    choices = example['choices']\n    labels  = choices['label']\n    texts   = choices['text']\n    answer_key = example['answerKey']\n    answer_text = ''\n    for label, text in zip(labels, texts):\n        if label == answer_key:\n            answer_text = text\n            break\n    return {\n        \"question\": example['question'],\n        \"context\":  example['question'],\n        \"answer\":   answer_text\n    }\n\ndef extract_squad(example):\n    \"\"\"Extract QA triple from SQuAD format.\"\"\"\n    answers = example.get('answers', {})\n    answer_text = answers.get('text', [''])[0] if answers.get('text') else ''\n    return {\n        \"question\": example['question'],\n        \"context\":  example['context'],\n        \"answer\":   answer_text\n    }\n\ndef extract_gsm8k(example):\n    \"\"\"Extract QA triple from GSM8K format.\"\"\"\n    ans_text = example['answer']\n    # GSM8K usually separates the chain-of-thought from the final answer with '####'\n    if '####' in ans_text:\n        answer = ans_text.split('####')[-1].strip()\n    else:\n        answer = ans_text\n    return {\n        \"question\": example['question'],\n        \"context\":  example['question'], # GSM8K does not have a separate context\n        \"answer\":   answer\n    }\n\ndef extract_humaneval(example):\n    \"\"\"Extract QA triple from HumanEval format.\"\"\"\n    return {\n        \"question\": example['prompt'],\n        \"context\":  example['prompt'], # Code completion doesn't have a separate context\n        \"answer\":   example['canonical_solution']\n    }\n\n# ── Extract all examples ─────────────────────────────────────\n\ndomains = {\n    \"medical\": [extract_medmcqa(ex)   for ex in medical],\n    \"science\": [extract_arc(ex)       for ex in science],\n    \"biology\": [extract_squad(ex)     for ex in biology],\n    \"math\":    [extract_gsm8k(ex)     for ex in math_ds],\n    \"coding\":  [extract_humaneval(ex) for ex in coding_ds],\n}\n\n# Filter out empty examples\nfor domain in domains:\n    domains[domain] = [\n        ex for ex in domains[domain]\n        if ex['question'] and ex['answer'] and ex['context']\n    ]\n    print(f\"  {domain}: {len(domains[domain])} valid examples\")\n\n# ── Build CTCB-Bench sessions ────────────────────────────────\n\ndomain_names = list(domains.keys())\nsessions = []\nsession_id = 0\n\nrandom.seed(SEED)\n\n# Generate sessions: near-neighbor domain pairs, varied prior turn counts\nfor n_prior in N_PRIOR_TURNS:\n    for _ in range(N_SESSIONS // len(N_PRIOR_TURNS)):\n        \n        # Pick contaminator and target domains using Hard-Mode pairings\n        contam_domain, target_domain = random.choice(NEAR_NEIGHBOR_PAIRS)\n        \n        # Sample prior turns from contaminator domain\n        prior_examples = random.sample(\n            domains[contam_domain],\n            min(n_prior, len(domains[contam_domain]))\n        )\n        prior_turns = [\n            {\"question\": ex[\"question\"], \"context\": ex[\"context\"], \"answer\": ex[\"answer\"]}\n            for ex in prior_examples\n        ]\n        \n        # Sample target example\n        target_ex = random.choice(domains[target_domain])\n        \n        sessions.append({\n            \"session_id\":          session_id,\n            \"n_prior_turns\":       n_prior,\n            \"contaminator_domain\": contam_domain,\n            \"target_domain\":       target_domain,\n            \"domain_pair\":         f\"{contam_domain}->{target_domain}\",\n            \"prior_turns\":         prior_turns,\n            \"target_document\":     target_ex[\"context\"],\n            \"target_query\":        target_ex[\"question\"],\n            \"gold_answer\":         target_ex[\"answer\"],\n        })\n        session_id += 1\n\nprint(f\"\\nBuilt {len(sessions)} CTCB-Bench sessions\")\nprint(f\"Domain pair distribution:\")\ndf_temp = pd.DataFrame(sessions)\nprint(df_temp.groupby(['contaminator_domain', 'target_domain']).size().to_string())\n\n# Save to disk\nsessions_path = OUTPUT_DIR / \"ctcb_bench_sessions.json\"\nwith open(sessions_path, 'w') as f:\n    json.dump(sessions, f, indent=2)\nprint(f\"\\nSessions saved to {sessions_path}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T04:25:00.770718Z","iopub.execute_input":"2026-06-17T04:25:00.771521Z","iopub.status.idle":"2026-06-17T04:25:14.838954Z","shell.execute_reply.started":"2026-06-17T04:25:00.771485Z","shell.execute_reply":"2026-06-17T04:25:14.838203Z"}},"outputs":[{"name":"stdout","text":"L