ery: str, sentences: list, bm25_idx: BM25Okapi, top_k: int = 8) -> list:\n    \"\"\"\n    SOTA Hybrid Retrieval with Sentence Boundary Expansion & Contiguous Merging.\n    Fixes the BERTScore drop by providing LLMs with cohesive paragraphs instead of fragmented sentences.\n    \"\"\"\n    if not sentences:\n        return []\n    n = len(sentences)\n\n    # 1. Hybrid Scoring (BM25 + SBERT)\n    query_tokens = word_tokenize(query.lower())\n    bm25_scores  = bm25_idx.get_scores(query_tokens)\n    bm25_order   = np.argsort(bm25_scores)[::-1]\n    bm25_rank    = {idx: rank for rank, idx in enumerate(bm25_order)}\n\n    q_emb   = SBERT.encode(query, convert_to_numpy=True)\n    s_embs  = SBERT.encode(sentences, convert_to_numpy=True, batch_size=64)\n    q_norm  = q_emb / (np.linalg.norm(q_emb) + 1e-10)\n    s_norms = s_embs / (np.linalg.norm(s_embs, axis=1, keepdims=True) + 1e-10)\n    dense_scores = s_norms @ q_norm\n    dense_order  = np.argsort(dense_scores)[::-1]\n    dense_rank   = {idx: rank for rank, idx in enumerate(dense_order)}\n\n    combined_rank = [bm25_rank[i] + dense_rank[i] for i in range(n)]\n    top_indices   = np.argsort(combined_rank)[:top_k].tolist()\n\n    # 2. SOTA Context Expansion (The LongCite Technique)\n    # Expand the winning sentences by +/- 1 sentence to capture surrounding narrative context\n    expanded_indices = set()\n    for idx in top_indices:\n        if idx > 0: expanded_indices.add(idx - 1)\n        expanded_indices.add(idx)\n        if idx < n - 1: expanded_indices.add(idx + 1)\n        \n    expanded_list = sorted(list(expanded_indices))\n\n    # 3. Contiguous Chunk Merging\n    # Combine adjacent sentences into fluid paragraphs so the LLM reads naturally\n    chunks = []\n    if not expanded_list:\n        return []\n\n    current_chunk_sents = [sentences[expanded_list[0]]]\n    current_anchor = expanded_list[0]\n\n    for j in range(1, len(expanded_list)):\n        prev_idx = expanded_list[j-1]\n        curr_idx = expanded_list[j]\n        \n        if curr_idx == prev_idx + 1:\n            # Sentences are next to each other in the document; merge them!\n            current_chunk_sents.append(sentences[curr_idx])\n        else:\n            # Gap found; save the completed paragraph and start a new one\n            chunks.append((\" \".join(current_chunk_sents), current_anchor))\n            current_chunk_sents = [sentences[curr_idx]]\n            current_anchor = curr_idx\n            \n    # Save the final paragraph\n    if current_chunk_sents:\n        chunks.append((\" \".join(current_chunk_sents), current_anchor))\n\n    return chunks","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T04:26:40.081102Z","iopub.execute_input":"2026-06-17T04:26:40.081745Z","iopub.status.idle":"2026-06-17T04:26:40.100525Z","shell.execute_reply.started":"2026-06-17T04:26:40.081714Z","shell.execute_reply":"2026-06-17T04:26:40.099548Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"# ============================================================\n# CELL 8: Main evaluation loop (6 Models - Bulletproof Version)\n# Runs models sequentially: load -> evaluate -> unload -> clear GPU -> clear disk\n# FIXED Issue 2 + 3: each model now has a \"prompt_style\" key so\n# build_qacap_prompt() applies the correct per-model instruction framing.\n# FIXED Issue 1: retrieve_top_k now called with top_k=8 (hybrid retrieval).\n# ============================================================\n\nimport shutil\nimport json\nimport os\nimport time\n\nprint(\"Performing pre-flight GPU memory sweep...\")\nclear_gpu_memory()\nprint(\"GPU ready.\")\n\n# -- 1. REGISTRY (6 Safe Models) ---------------------------------\nMODEL_REGISTRY = [\n    {\n        \"name\":              \"Phi-3.5 Mini Instruct\",\n        \"model_id\":          \"microsoft/Phi-3.5-mini-instruct\",\n        \"use_4bit\":          False,\n        \"trust_remote_code\": False,\n        \"family\":            \"Microsoft Phi\",\n  