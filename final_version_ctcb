    "# ============================================================\n",
    "# CELL 9: Compute all metrics on collected raw results\n",
    "# Run after all models complete — no GPU needed for metrics\n",
    "# ============================================================\n",
    "\n",
    "import json\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "OUTPUT_DIR = Path(\"/kaggle/working/ctcb_comparison\")\n",
    "master_path = OUTPUT_DIR / \"all_raw_results.json\"\n",
    "\n",
    "print(\"Computing all metrics on collected responses...\")\n",
    "print(\"This may take 10-20 minutes for BERTScore.\")\n",
    "\n",
    "# Load raw results\n",
    "if not master_path.exists():\n",
    "    raise FileNotFoundError(f\"Could not find raw results at {master_path}.\")\n",
    "\n",
    "with open(master_path) as f:\n",
    "    all_raw_results = json.load(f)\n",
    "\n",
    "df_raw = pd.DataFrame(all_raw_results)\n",
    "print(f\"Loaded {len(df_raw)} records across {df_raw['model_name'].nunique()} models\")\n",
    "\n",
    "# ── Compute metrics per model ─────────────────────────────────\n",
    "\n",
    "metrics_records = []\n",
    "\n",
    "for model_name in df_raw['model_name'].unique():\n",
    "    print(f\"\\nComputing metrics for: {model_name}\")\n",
    "    \n",
    "    df_model = df_raw[df_raw['model_name'] == model_name].copy()\n",
    "    \n",
    "    # Ensure no None types\n",
    "    df_model = df_model.dropna(subset=['baseline_response', 'qacap_response'])\n",
    "    \n",
    "    if len(df_model) == 0:\n",
    "        print(f\"  Warning: No valid rows for {model_name}. Skipping...\")\n",
    "        continue\n",
    "        \n",
    "    gold_answers   = df_model['gold_answer'].tolist()\n",
    "    target_docs    = df_model['target_document'].tolist()\n",
    "    contams        = df_model['contaminator_doc'].tolist()\n",
    "    \n",
    "    # FIXED: Sanitize empty strings to prevent bert_score tokenizer crash\n",
    "    baseline_resps = [str(r) if str(r).strip() else \"[EMPTY RESPONSE]\" for r in df_model['baseline_response']]\n",
    "    qacap_resps    = [str(r) if str(r).strip() else \"[EMPTY RESPONSE]\" for r in df_model['qacap_response']]\n",
    "    \n",
    "    # ── BASELINE metrics ─────────────────────────────────────\n",
    "    print(\"  Computing ROUGE (baseline)...\")\n",
    "    baseline_rouge = compute_rouge(baseline_resps, gold_answers)\n",
    "    \n",
    "    print(\"  Computing BERTScore (baseline) — slow step...\")\n",
    "    baseline_bert = compute_bertscore(baseline_resps, gold_answers)\n",
    "    \n",
    "    print(\"  Computing SGI (baseline)...\")\n",
    "    baseline_sgi = compute_sgi_batch(baseline_resps, target_docs, contams)\n",
    "    \n",
    "    print(\"  Computing contamination severity (baseline)...\")\n",
    "    baseline_contam = compute_contamination_severity(baseline_resps, contams)\n",
    "    \n",
    "    baseline_lengths = compute_response_length_stats(baseline_resps)\n",
    "    \n",
    "    # ── QA-CAP metrics ────────────────────────────────────────\n",
    "    print(\"  Computing ROUGE (QA-CAP)...\")\n",
    "    qacap_rouge = compute_rouge(qacap_resps, gold_answers)\n",
    "    \n",
    "    print(\"  Computing BERTScore (QA-CAP)...\")\n",
    "    qacap_bert = compute_bertscore(qacap_resps, gold_answers)\n",
    "    \n",
    "    print(\"  Computing SGI (QA-CAP)...\")\n",
    "    qacap_sgi = compute_sgi_batch(qacap_resps, target_docs, contams)\n",
    "    \n",
    "    print(\"  Computing contamination severity (QA-CAP)...\")\n",
    "    qacap_contam = compute_contamination_severity(qacap_resps, contams)\n",
    "    \n",
    "    qacap_lengths = compute_response_length_stats(qacap_resps)\n",
    "    \n",
    "    # ── Store aggregated metrics ──────────────────────────────\n",
    "    speed_row = df_model.iloc[0]\n",
    "    \n",
    "    metrics_records.append({\n",
    "        \"model\":                   model_name,\n",
    "        \"family\":                  df_model.iloc[0]['model_family'],\n",
    "        \"n_sessions\":              len(df_model),\n",
    "        \"tokens_per_sec\":          speed_row['tokens_per_sec'],\n",
    "        \"vram_used_gb\":            speed_row['vram_used_gb'],\n",
    "        \n",
    "        # BASELINE\n",
    "        \"bl_rouge1_f1\":            round(baseline_rouge['rouge1_f1'], 4),\n",
    "        \"bl_rouge2_f1\":            round(baseline_rouge['rouge2_f1'], 4),\n",
    "        \"bl_rougeL_f1\":            round(baseline_rouge['rougeL_f1'], 4),\n",
    "        \"bl_bertscore_f1\":         round(baseline_bert['f1_mean'],    4),\n",
    "        \"bl_sgi\":                  round(baseline_sgi['sgi_mean'],    4),\n",
    "        \"bl_ctcb_rate\":            round(baseline_sgi['ctcb_rate'],   4),\n",
    "        \"bl_contam_severity\":      round(baseline_contam['severity_mean'], 4),\n",
    "        \"bl_response_len\":         baseline_lengths['length_mean'],\n",
    "        \n",
    "        # QA-CAP\n",
    "        \"qc_rouge1_f1\":            round(qacap_rouge['rouge1_f1'],    4),\n",
    "        \"qc_rouge2_f1\":            round(qacap_rouge['rouge2_f1'],    4),\n",
    "        \"qc_rougeL_f1\":            round(qacap_rouge['rougeL_f1'],    4),\n",
    "        \"qc_bertscore_f1\":         round(qacap_bert['f1_mean'],       4),\n",
    "        \"qc_sgi\":                  round(qacap_sgi['sgi_mean'],       4),\n",
    "        \"qc_ctcb_rate\":            round(qacap_sgi['ctcb_rate'],      4),\n",
    "        \"qc_contam_severity\":      round(qacap_contam['severity_mean'], 4),\n",
    "        \"qc_response_len\":         qacap_lengths['length_mean'],\n",
    "        \n",
    "        # DELTAS\n",
    "        \"delta_rouge1\":            round(qacap_rouge['rouge1_f1']      - baseline_rouge['rouge1_f1'],    4),\n",
    "        \"delta_bertscore\":         round(qacap_bert['f1_mean']         - baseline_bert['f1_mean'],       4),\n",
    "        \"delta_sgi\":               round(qacap_sgi['sgi_mean']         - baseline_sgi['sgi_mean'],       4),\n",
    "        \"delta_ctcb_rate\":         round(qacap_sgi['ctcb_rate']        - baseline_sgi['ctcb_rate'],      4),\n",
    "        \"delta_contam_severity\":   round(qacap_contam['severity_mean'] - baseline_contam['severity_mean'], 4),\n",
    "    })\n",
    "    \n",
    "    print(f\"  Done. CTCB-Rate: {baseline_sgi['ctcb_rate']:.1%} → {qacap_sgi['ctcb_rate']:.1%}\")\n",
    "\n",
    "df_metrics = pd.DataFrame(metrics_records)\n",
    "\n",
    "# Save results\n",
    "metrics_path = OUTPUT_DIR / \"computed_metrics.csv\"\n",
    "df_metrics.to_csv(metrics_path, index=False)\n",
    "print(f\"\\nAll metrics saved to {metrics_path}\")\n",
    "print(df_metrics[['model', 'bl_ctcb_rate', 'qc_ctcb_rate', 'delta_ctcb_rate']].to_string())"
   ]
