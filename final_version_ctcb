    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "\n",
    "OUTPUT_DIR = Path(\"/kaggle/working/ctcb_comparison\")\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "CACHE_DIR = Path(\"/kaggle/working/model_cache\")\n",
    "CACHE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Evaluation config\n",
    "MAX_NEW_TOKENS = 256        # Max tokens generated per response\n",
    "TEMPERATURE    = 0.0        # Deterministic generation (greedy)\n",
    "TOP_P          = 1.0        # No nucleus sampling at temp=0\n",
    "N_SESSIONS     = 100        # Sessions per model (increase to 500 for full benchmark)\n",
    "N_PRIOR_TURNS  = [0, 20, 50, 100] # Prior contaminator turns to test\n",
    "\n",
    "NEAR_NEIGHBOR_PAIRS = [\n",
    "    (\"medical\", \"biology\"),\n",
