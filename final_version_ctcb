model_name   = model_info[\"name\"]\n    model_id     = model_info[\"model_id\"]\n    use_4bit     = model_info[\"use_4bit\"]\n    trust_rc     = model_info[\"trust_remote_code\"]\n    prompt_style = model_info.get(\"prompt_style\", \"default\")\n    \n    sep = \"=\" * 60\n    print(f\"\\n{sep}\")\n    print(f\"Evaluating: {model_name}  (prompt_style={prompt_style})\")\n    print(f\"{sep}\")\n    \n    try:\n        model, tokenizer = load_model(model_id, use_4bit=use_4bit, trust_remote_code=trust_rc)\n    except Exception as e:\n        print(f\"FAILED to load {model_name}: {e}\")\n        return []\n    \n    speed_metrics = measure_inference_speed(model, tokenizer, SPEED_TEST_PROMPT)\n    print(f\"  Speed: {speed_metrics['tokens_per_sec']} tok/s | VRAM: {speed_metrics['vram_used_gb']} GB\")\n    \n    results = []\n    \n    for i, session in enumerate(sessions):\n        if i % 20 == 0:\n            print(f\"  Progress: {i}/{len(sessions)} sessions...\")\n        \n        session_id    = session['session_id']\n        n_prior       = session['n_prior_turns']\n        domain_pair   = session['domain_pair']\n        target_doc    = session['target_document']\n        gold_answer   = session['gold_answer']\n        \n        # Contaminator document: concatenation of prior turn contexts\n        contam_doc = \" \".join([turn['context'] for turn in session['prior_turns']]) if session['prior_turns'] else target_doc \n        \n        # Baseline Generate\n        try:\n            baseline_prompt   = build_baseline_prompt(session, tokenizer)\n            baseline_response = generate_response(model, tokenizer, baseline_prompt)\n        except Exception:\n            baseline_response = \"\"\n        \n        # QA-CAP Generate\n        try:\n            target_sentences = sent_tokenize(target_doc)\n            bm25_idx         = build_bm25_index(target_sentences)\n            retrieved_chunks = retrieve_top_k(session['target_query'], target_sentences, bm25_idx, top_k