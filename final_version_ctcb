   "source": [
    "# ============================================================\n",
    "# CELL 8: Main evaluation loop (6 Models - Bulletproof Version)\n",
    "# Runs models sequentially: load -> evaluate -> unload -> clear GPU -> clear disk\n",
    "# FIXED Issue 2 + 3: each model now has a \"prompt_style\" key so\n",
    "# build_qacap_prompt() applies the correct per-model instruction framing.\n",
    "# FIXED Issue 1: retrieve_top_k now called with top_k=8 (hybrid retrieval).\n",
    "# ============================================================\n",
    "\n",
    "import shutil\n",
    "import json\n",
    "import os\n",
    "import time\n",
    "\n",
    "print(\"Performing pre-flight GPU memory sweep...\")\n",
    "clear_gpu_memory()\n",
    "print(\"GPU ready.\")\n",
    "\n",
    "# -- 1. REGISTRY (6 Safe Models) ---------------------------------\n",
    "MODEL_REGISTRY = [\n",
    "    {\n",
    "        \"name\":              \"Phi-3.5 Mini Instruct\",\n",
    "        \"model_id\":          \"microsoft/Phi-3.5-mini-instruct\",\n",
    "        \"use_4bit\":          False,\n",
    "        \"trust_remote_code\": False,\n",
    "        \"family\":            \"Microsoft Phi\",\n",
    "        \"prompt_style\":      \"default\",\n",
    "    },\n",
    "    {\n",
    "        \"name\":              \"Mistral 7B Instruct\",\n",
    "        \"model_id\":          \"mistralai/Mistral-7B-Instruct-v0.3\",\n",
    "        \"use_4bit\":          True,\n",
    "        \"trust_remote_code\": False,\n",
    "        \"family\":            \"Mistral\",\n",
    "        \"prompt_style\":      \"default\",\n",
    "    },\n",
    "    {\n",
    "        \"name\":              \"Llama 3.1 8B Instruct\",\n",
    "        \"model_id\":          \"meta-llama/Meta-Llama-3.1-8B-Instruct\",\n",
    "        \"use_4bit\":          True,\n",
    "        \"trust_remote_code\": False,\n",
    "        \"family\":            \"Meta Llama\",\n",
    "        \"prompt_style\":      \"llama\",\n",
    "    },\n",
    "    {\n",
    "        \"name\":              \"Qwen2.5 7B Instruct\",\n",
    "        \"model_id\":          \"Qwen/Qwen2.5-7B-Instruct\",\n",
    "        \"use_4bit\":          True,\n",
    "        \"trust_remote_code\": False,\n",
    "        \"family\":            \"Alibaba Qwen\",\n",
    "        \"prompt_style\":      \"qwen\",\n",
    "    },\n",
    "    {\n",
    "        \"name\":              \"Gemma 2 9B Instruct\",\n",
    "        \"model_id\":          \"google/gemma-2-9b-it\",\n",
    "        \"use_4bit\":          True,\n",
    "        \"trust_remote_code\": False,\n",
    "        \"family\":            \"Google Gemma\",\n",
    "        \"prompt_style\":      \"gemma\",\n",
    "    },\n",
    "    {\n",
    "        \"name\":              \"Falcon 7B Instruct\",\n",
    "        \"model_id\":          \"tiiuae/falcon-7b-instruct\",\n",
    "        \"use_4bit\":          True,\n",
    "        \"trust_remote_code\": False, # Falcon is now HF native\n",
    "        \"family\":            \"TII Falcon\",\n",
    "        \"prompt_style\":      \"default\",\n",
    "    }\n",
    "]\n",
    "\n",
    "SPEED_TEST_PROMPT = (\n",
    "    \"Here is a document about graph neural networks. \"\n",
    "    \"GNNs aggregate features from neighbouring nodes through message passing. \"\n",
    "    \"Question: What is the message passing mechanism? \"\n",
    "    \"Answer:\"\n",
    ")\n",
    "\n",
    "# -- 2. EVALUATION FUNCTION ----------------------------------------\n",
    "\n",
    "def evaluate_model(model_info: dict, sessions: list) -> list:\n",
    "    model_name   = model_info[\"name\"]\n",
    "    model_id     = model_info[\"model_id\"]\n",
    "    use_4bit     = model_info[\"use_4bit\"]\n",
    "    trust_rc     = model_info[\"trust_remote_code\"]\n",
    "    prompt_style = model_info.get(\"prompt_style\", \"default\")\n",
    "    \n",
    "    sep = \"=\" * 60\n",
    "    print(f\"\\n{sep}\")\n",
    "    print(f\"Evaluating: {model_name}  (prompt_style={prompt_style})\")\n",
    "    print(f\"{sep}\")\n",
    "    \n",
    "    try:\n",
    "        model, tokenizer = load_model(model_id, use_4bit=use_4bit, trust_remote_code=trust_rc)\n",
    "    except Exception as e:\n",
    "        print(f\"FAILED to load {model_name}: {e}\")\n",
    "        return []\n",
    "    \n",
    "    speed_metrics = measure_inference_speed(model, tokenizer, SPEED_TEST_PROMPT)\n",
    "    print(f\"  Speed: {speed_metrics['tokens_per_sec']} tok/s | VRAM: {speed_metrics['vram_used_gb']} GB\")\n",
    "    \n",
    "    results = []\n",
    "    \n",
    "    for i, session in enumerate(sessions):\n",
    "        if i % 20 == 0:\n",
    "            print(f\"  Progress: {i}/{len(sessions)} sessions...\")\n",
    "        \n",
    "        session_id    = session['session_id']\n",
    "        n_prior       = session['n_prior_turns']\n",
    "        domain_pair   = session['domain_pair']\n",
    "        target_doc    = session['target_document']\n",
    "        gold_answer   = session['gold_answer']\n",
    "        \n",
    "        # Contaminator document: concatenation of prior turn contexts\n",
    "        contam_doc = \" \".join([turn['context'] for turn in session['prior_turns']]) if session['prior_turns'] else target_doc \n",
    "        \n",
    "        # Baseline Generate\n",
    "        try:\n",
    "            baseline_prompt   = build_baseline_prompt(session, tokenizer)\n",
    "            baseline_response = generate_response(model, tokenizer, baseline_prompt)\n",
    "        except Exception:\n",
    "            baseline_response = \"\"\n",
    "        \n",
    "        # QA-CAP Generate\n",
    "        try:\n",
    "            target_sentences = sent_tokenize(target_doc)\n",
    "            bm25_idx         = build_bm25_index(target_sentences)\n",
    "            retrieved_chunks = retrieve_top_k(session['target_query'], target_sentences, bm25_idx, top_k=8)\n",
    "            qacap_prompt     = build_qacap_prompt(session, retrieved_chunks, tokenizer, prompt_style=prompt_style)\n",
    "            qacap_response   = generate_response(model, tokenizer, qacap_prompt)\n",
    "        except Exception:\n",
    "            qacap_response = \"\"\n",
    "        \n",
    "        results.append({\n",
    "            \"model_name\":          model_name,\n",
    "            \"model_family\":        model_info[\"family\"],\n",
    "            \"session_id\":          session_id,\n",
    "            \"n_prior_turns\":       n_prior,\n",
    "            \"domain_pair\":         domain_pair,\n",
    "            \"gold_answer\":         gold_answer,\n",
    "            \"target_document\":     target_doc,\n",
    "            \"contaminator_doc\":    contam_doc,\n",
    "            \"baseline_response\":   baseline_response,\n",
    "            \"qacap_response\":      qacap_response,\n",
    "            \"tokens_per_sec\":      speed_metrics[\"tokens_per_sec\"],\n",
    "            \"vram_used_gb\":        speed_metrics[\"vram_used_gb\"],\n",
    "        })\n",
    "    \n",
    "    # -- SAFE TEARDOWN SEQUENCE ----------------------------------\n",
    "    print(f\"  Unloading {model_name} from GPU memory...\")\n",
    "    del model\n",
    "    del tokenizer\n",
    "    clear_gpu_memory()\n",
    "    \n",
    "    print(f\"  Clearing disk cache to prevent Kaggle crashes...\")\n",
    "    if CACHE_DIR.exists():\n",
    "        shutil.rmtree(CACHE_DIR)\n",
    "        CACHE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "    time.sleep(2) # Give the OS a moment to register the freed space\n",
    "    \n",
    "    raw_path = OUTPUT_DIR / f\"raw_{model_name.replace(' ', '_')}.json\"\n",
    "    with open(raw_path, 'w') as f:\n",
    "        json.dump(results, f, indent=2)\n",
    "    print(f\"  Raw results saved for {model_name}\")\n",
    "    \n",
    "    return results\n",
    "\n",
    "# -- 3. MASTER APPEND ------------------------------------------------\n",
    "\n",
    "master_path = OUTPUT_DIR / \"all_raw_results.json\"\n",
    "all_raw_results = []\n",
    "\n",
    "# Load existing records if they exist to prevent overwriting\n",
    "if master_path.exists():\n",
    "    with open(master_path, 'r') as f:\n",
    "        all_raw_results = json.load(f)\n",
    "    print(f\"Loaded {len(all_raw_results)} previous records.\")\n",
    "\n",
    "for model_info in MODEL_REGISTRY:\n",
    "    model_results = evaluate_model(model_info, sessions)\n",
    "    all_raw_results.extend(model_results)\n",
    "    \n",
    "    with open(master_path, 'w') as f:\n",
    "        json.dump(all_raw_results, f, indent=2)\n",
    "    print(f\"Master results safely updated: {len(all_raw_results)} total records.\")\n",
    "\n",
    "print(f\"\\nAll models evaluated. Generation phase complete!\")"
   ]
