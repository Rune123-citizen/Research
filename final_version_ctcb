QUANTISATION_CONFIG = BitsAndBytesConfig(\n    load_in_4bit=True,\n    bnb_4bit_compute_dtype=torch.float16,  # compute in FP16 despite 4-bit storage\n    bnb_4bit_use_double_quant=True,         # nested quantisation saves ~0.4GB extra\n    bnb_4bit_quant_type=\"nf4\",              # NormalFloat4 — optimal for LLM weights\n)\n\ndef clear_gpu_memory():\n    \"\"\"\n    Aggressively clear GPU memory between model loads.\n    Call this after deleting a model before loading the next one.\n    \"\"\"\n    gc.collect()\n    if torch.cuda.is_available():\n        torch.cuda.empty_cache()\n        torch.cuda.ipc_collect()\n    time.sleep(2)  # Give CUDA driver time to release memory\n\n\ndef load_model(model_id: str, use_4bit: bool = True, trust_remote_code: bool = False) -> tuple:\n    \"\"\"\n    Load a HuggingFace causal LM with optional 4-bit quantisation.\n    \"\"\"\n    print(f\"\\nLoading: {model_id}\")\n    print(f\"  Quantisation: {'4-bit NF4' if use_4bit else 'FP16'}\")\n    print(f\"  Trust Remote Code: {trust_remote_code}\")\n    \n    load_start = time.time()\n    \n    # ── Load tokenizer ────────────────────────────────────────\n    tokenizer = AutoTokenizer.from_pretrained(\n        model_id,\n        cache_dir=str(CACHE_DIR),\n        trust_remote_code=trust_remote_code,   # FIXED: Now dynamic\n        token=HF_TOKEN\n    )\n    \n    # Many models lack a pad token — set to eos token\n    if tokenizer.pad_token is None:\n        tokenizer.pad_token = tokenizer.eos_token\n        tokenizer.pad_token_id = tokenizer.eos_token_id\n    \n    # ── Load model ────────────────────────────────────────────\n    model_kwargs = {\n        \"cache_dir\":         str(CACHE_DIR),\n        \"trust_remote_code\": trust_remote_code, # FIXED: Now dynamic\n        \"token\":             HF_TOKEN,\n        \"torch_dtype\":       torch.float16,\n    }\n    \n    if use_4bit and DEVICE == \"cuda\":\n        model_kwargs[\"quantization_config\"] = QUANTISATION_CONFIG\n        model_kwargs[\"device_map\"]          = \"auto\"\n    else:\n        model_kwargs[\"device_map\"] = DEVICE\n    \n    model = AutoModelForCausalLM.from_pretrained(model_id, **model_kwargs)\n    model.eval()\n    \n    load_time = time.time() - load_start\n    \n    if DEVICE == \"cuda\":\n        vram = torch.cuda.memory_allocated() / 1e9\n        print(f\"  Load time:  {load_time:.1f}s\")\n        print(f\"  VRAM used:  {vram:.2f} GB\")\n    \n    return model, tokenizer\n\n\ndef generate_response(\n    model,\n    tokenizer,\n    prompt: str,\n    max_new_tokens: int = MAX_NEW_TOKENS\n) -> str:\n    \"\"\"Generate a single response string from a loaded model.\"\"\"\n    inputs = tokenizer(\n        prompt,\n        return_tensors=\"pt\",\n        truncation=True,\n        max_length=2048,\n        padding=False\n    ).to(DEVICE)\n    \n    input_length = inputs['input_ids'].shape[1]\n    \n    with torch.no_grad():\n        output_ids = model.generate(\n            **inputs,\n            max_new_tokens=max_new_tokens,\n            do_sample=False,\n            repetition_penalty=1.1,\n            pad_token_id=tokenizer.eos_token_id,\n            eos_token_id=tokenizer.eos_token_id,\n        )\n    \n    new_token_ids = output_ids[0][input_length:]\n    response = tokenizer.decode(new_token_ids, skip_special_tokens=True)\n    \n    return response.strip()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T04:26:31.217401Z","iopub.execute_input":"2026-06-17T04:26:31.218236Z","iopub.status.idle":"2026-06-17T04:26:31.318145Z","shell.execute_reply.started":"2026-06-17T04:26:31.218202Z","shell.execute_reply":"2026-06-17T04:26:31.316984Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"# ============================================================\n# CELL 7: Prompt builders & SOTA Hybrid Retrieval (QA-CAP v3)\n# ============================================================\nimport numpy as np\nfrom nltk.tokenize import word_tokenize\nfrom rank_bm25 import BM25Okapi\n\ndef build_baseline_prompt(session: dict, tokenizer) -> str:\n    messages = []\n    messages.append({\n        \"role\": \"system\",\n        \"content\": \"You are a helpful assistant. Answer questions accurately, comprehensively, and fluently.\"\n    })\n    \n    for i, turn in enumerate(session['prior_turns']):\n        messages.append({\"role\": \"user\",      \"content\": turn['question']})\n        messages.append({\"role\": \"assistant\", \"content\": turn['answer']})\n    \n    current_user_msg = (\n        f\"Here is a document for you to read:\\n\\n\"\n        f\"{session['target_document']}\\n\\n\"\n        f\"Question: {session['target_query']}\\n\\n\"\n        f\"Please answer comprehensively based on the document above.\"\n    )\n    messages.append({\"role\": \"user\", \"content\": current_user_msg})\n    \n    try:\n        prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n    except Exception:\n        prompt = \"\"\n        for msg in messages:\n            prompt += f\"\\n{msg['role'].upper()}: {msg['content']}\"\n        prompt += \"\\nASSISTANT:\"\n    return prompt\n\n\ndef build_qacap_prompt(session: dict, retrieved_chunks: list, tokenizer, prompt_style: str = \"default\") -> str:\n    # Use standard brackets [1] instead of <C1> so Gemma doesn't confuse them with system tokens\n    numbered_context = \"\"\n    for chunk_text, anchor_idx in retrieved_chunks:\n        numbered_context += f\"[{anchor_idx}] {chunk_text}\\n\\n\"\n\n    # SOTA Prompting: We explicitly demand \"fluent, comprehensive paragraphs\" to boost BERTScore\n    if prompt_style == \"gemma\":\n        system_msg = (\n            \"You are a precise research assistant. \"\n            \"Answer the question using ONLY the provided document passages below. \"\n            \"Write a fluent, comprehensive, and natural-sounding paragraph. \"\n            \"Reference passage numbers like [1] or [2] when you