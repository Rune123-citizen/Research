===============================\n# CELL 5: All evaluation metric functions\n# Each function is self-contained and independently testable\n# ============================================================\n\n# Load SBERT once globally — reused across all metric computations\nprint(\"Loading SBERT model for semantic metrics...\")\nSBERT = SentenceTransformer('all-MiniLM-L6-v2', device=DEVICE)\n# Using MiniLM (384-dim) instead of MPNet (768-dim) to save VRAM\n# Slightly less accurate but enough for relative comparisons\nprint(\"SBERT loaded.\")\n\n# ── Metric 1: BERTScore F1 ───────────────────────────────────\ndef compute_bertscore(predictions: list, references: list) -> dict:\n    \"\"\"\n    Compute BERTScore F1 between predicted responses and gold answers.\n    BERTScore uses contextual BERT embeddings — captures semantic similarity\n    better than n-gram overlap metrics.\n    \n    Args:\n        predictions: list of generated response strings\n        references:  list of gold answer strings (same length)\n    \n    Returns:\n        dict with keys: precision_mean, recall_mean, f1_mean, f1_scores (list)\n    \"\"\"\n    if not predictions or not references:\n        return {\"precision_mean\": 0.0, \"recall_mean\": 0.0, \n                \"f1_mean\": 0.0, \"f1_scores\": []}\n    \n    # bert_score returns tensor lists: P, R, F1 per example\n    P, R, F1 = bert_score_fn(\n        predictions,\n        references,\n        lang=\"en\",\n        model_type=\"distilbert-base-uncased\",  # lighter model, faster\n        device=DEVICE,\n        verbose=False\n    )\n    \n    return {\n        \"precision_mean\": float(P.mean()),\n        \"recall_mean\":    float(R.mean()),\n        \"f1_mean\":        float(F1.mean()),\n        \"f1_scores\":      F1.tolist()\n    }\n\n\n# ── Metric 2: ROUGE Scores ───────────────────────────────────\ndef compute_rouge(predictions: list, references: list) -> dict:\n    \"\"\"\n    Compute ROUGE-1, ROUGE-2, ROUGE-L F1 scores.\n    ROUGE measures n-gram overlap with reference text.\n    ROUGE-1: unigram overlap | ROUGE-2: bigram | ROUGE-L: longest common subsequence\n    \n    Args:\n        predictions: list of generated response strings\n        references:  list of gold answer strings\n    \n    Returns:\n        dict with rouge1_f1, rouge2_f1, rougeL_f1 (all means over list)\n    \"\"\"\n    scorer = rouge_lib.RougeScorer(\n        ['rouge1', 'rouge2', 'rougeL'],\n        use_stemmer=True\n    )\n    \n    r1_scores, r2_scores, rL_scores = [], [], []\n    \n    for pred, ref in zip(predictions, references):\n        if not pred or not ref:\n            r1_scores.append(0.0)\n            r2_scores.append(0.0)\n            rL_scores.append(0.0)\n            continue\n        \n        scores = scorer.score(ref, pred)  # (reference, prediction) order\n        r1_scores.append(scores['rouge1'].fmeasure)\n        r2_scores.append(scores['rouge2'].fmeasure)\n        rL_scores.append(scores['rougeL'].fmeasure)\n    \n    return {\n        \"rouge1_f1\": np.mean(r1_scores),\n        \"rouge2_f1\": np.mean(r2_scores),\n        \"rougeL_f1\": np.mean(rL_scores),\n    }\n\n\n# ── Metric 3: SGI — Semantic Grounding Index ─────────────────\ndef compute_sgi_batch(\n    responses:         list,\n    target_documents:  list,\n    contaminator_docs: list\n) -> dict:\n    \"\"\"\n    Compute SGI for a batch of (response, target_doc, contam_doc) triples.\n    \n    SGI = cos_sim(response, target_doc) - cos_sim(response, contaminator_doc)\n    Positive SGI → response closer to correct document (safe)\n    Negative SGI → response closer to contaminator (CTCB detected)\n    \n    Args:\n        responses:         list of generated response strings\n        target_documents:  list of target document strings (correct source)\n        contaminator_docs: list of contaminator document strings (wrong source)\n    \n    Returns:\n        dict with sgi_mean, sgi_scores (list), ctcb_rate (float 0–1)\n    \"\"\"\n    if not responses:\n        return {\"sgi_mean\": 0.0, \"sgi_scores\": [], \"ctcb_rate\": 0.0}\n    \n    # Batch encode all texts at once for efficiency\n    all_texts = responses + target_documents + contaminator_docs\n    all_embeddings = SBERT.encode(all_texts, batch_size=32, convert_to_numpy=True)\n    \n    n = len(responses)\n    resp_embs   = all_embeddings[:n]\n    target_embs = all_embeddings[n:2*n]\n    contam_embs = all_embeddings[2*n:]\n    \n    sgi_scores = []\n    for r_emb, t_emb, c_emb in zip(resp_embs, target_embs, contam_embs):\n        # Cosine similarity: dot product of unit vectors\n        r_norm = r_emb / (np.linalg.norm(r_emb) + 1e-10)\n        t_norm = t_emb / (np.linalg.norm(t_emb) + 1e-10)\n        c_norm = c_emb / (np.linalg.norm(c_emb) + 1e-10)\n        \n        target_sim = float(np.dot(r_norm, t_norm))\n        contam_sim = float(np.dot(r_norm, c_norm))\n        sgi = target_sim - contam_sim\n        sgi_scores.append(sgi)\n    \n    ctcb_detected = [1 if sgi < 0.0 else 0 for sgi in sgi_scores]\n    \n    return {\n        \"sgi_mean\":   np.mean(sgi_scores),\n        \"sgi_scores\": sgi_scores,\n        \"ctcb_rate\":  np.mean(ctcb_detected),  # fraction of sessions with SGI < 0\n    }\n\n\n# ── Metric 4: Contamination Severity ─────────────────────────\ndef compute_contamination_severity(\n    responses:        list,\n    contaminator_docs: list\n) -> dict:\n    \"\"\"\n    Measures how semantically similar each response is to the contaminator\n    (wrong-topic) document. Higher = more contamination from prior topic.\n    \n    Args:\n        responses:         list of generated response strings\n        contaminator_docs: list of contaminator document strings\n    \n    Returns:\n        dict with severity_mean, severity_scores (list)\n    \"\"\"\n    if not responses:\n        return {\"severity_mean\": 0.0, \"severity_scores\": []}\n    \n    resp_embs   = SBERT.encode(responses,         convert_to_numpy=True)\n    contam_embs = SBERT.encode(contaminator_docs, convert_to_numpy=True)\n    \n    severity_scores = []\n    for r_emb, c_emb in zip(resp_embs, contam_embs):\n        r_norm = r_emb / (np.linalg.norm(r_emb) + 1e-10)\n        c_norm = c_emb / (np.linalg.norm(c_emb) + 1e-10)\n        severity = float(np.dot(r_norm, c_norm))\n        severity_scores.append(severity)\n    \n    return {\n        \"severity_mean\":   np.mean(severity_scores),\n        \"severity_scores\": severity_scores,\n    }\n\n\n# ── Metric 5: Inference Speed & VRAM ─────────────────────────\ndef measure_inference_speed(\n    model,\n    tokenizer,\n    sample_prompt: str,\n    n_warmup:  int = 2,\n    n_measure: int = 5\n) -> dict:\n    \"\"\"\n    Measure tokens/second and VRAM usage for a loaded model.\n    \n    Args:\n        model:         loaded HuggingFace model (on GPU)\n        tokenizer:     corresponding tokenizer\n        sample_prompt: a representative prompt string for timing\n        n_warmup:      warmup runs (not measured)\n        n_measure:     measured runs (averaged)\n    \n    Returns:\n        dict with tokens_per_sec, vram_used_gb, avg_latency_sec\n    \"\"\"\n    # Ensure pad token exists to avoid issues during generation batches\n    if tokenizer.pad_token_id is None:\n        tokenizer.pad_token_id = tokenizer.eos_token_id\n\n    inputs = tokenizer(\n        sample_prompt,\n        return_tensors=\"pt\",\n        truncation=True,\n        max_length=512\n    ).to(DEVICE)\n    \n    # Warmup\n    for _ in range(n_warmup):\n        with torch.no_grad():\n            _ = model.generate(**inputs, max_new_tokens=50, do_sample=False, pad_token_id=tokenizer.pad_token_id)\n    \n    # Measure\n    latencies    = []\n    token_counts = []\n    \n    for _ in range(n_measure):\n        torch.cuda.synchronize() if DEVICE == \"cuda\" else None\n        start = time.perf_counter()\n        \n        with torch.no_grad():\n            output = model.generate(\n                **inputs,\n                max_new_tokens=MAX_NEW_TOKENS,\n                do_sample=False, # FIXED: Removed explicit temperature parameter here to pass strict validation rules when sampling is disabled\n                pad_token_id=tokenizer.pad_token_id\n            )\n        \n        torch.cuda.synchronize() if DEVICE == \"cuda\" else None\n        end = time.perf_counter()\n        \n        n_generated = output.shape[1] - inputs['input_ids'].shape[1]\n        latencies.append(end - start)\n        token_counts.append(n_generated)\n    \n    avg_latency = np.mean(latencies)\n    avg_tokens  = np.mean(token_counts)\n    tps         = avg_tokens / avg_latency if avg_latency > 0 else 0.0\n    \n    # VRAM measurement\n    vram_gb = 0.0\n    if DEVICE == \"cuda\":\n        torch.cuda.synchronize()\n        vram_bytes = torch.cuda.max_memory_allocated()\n        vram_gb    = vram_bytes / 1e9\n        torch.cuda.reset_peak_memory_stats()\n    \n    return {\n        \"tokens_per_sec\":    round(tps, 1),\n        \"vram_used_gb\":      round(vram_gb, 2),\n        \"avg_latency_sec\":   round(avg_latency, 2),\n    }\n\n\n# ── Metric 6: Response Length Stats ──────────────────────────\ndef compute_response_length_stats(responses: list) -> dict:\n    \"\"\"Compute word count statistics across a list of responses.\"\"\"\n    lengths = [len(r.split()) for r in responses if r]\n    if not lengths:\n        return {\"length_mean\": 0, \"length_std\": 0, \"length_median\": 0}\n    return {\n        \"length_mean\":   round(np.mean(lengths), 1),\n        \"length_std\":    round(np.std(lengths), 1),\n        \"length_median\": int(np.median(lengths)),\n    }\n\n\n# ── Test all metrics with dummy data ─────────────────────────\nprint(\"\\nTesting all metrics with dummy data...\")\n\ndummy_preds = [\n    \"The pancreas produces insulin to regulate blood glucose levels.\",\n    \"Graph neural networks aggregate features from neighbouring nodes.\",\n    \"The contract requires offer, acceptance, and consideration.\"\n]\ndummy_refs = [\n    \"Insulin is secreted by beta cells in the pancreas.\",\n    \"GNNs perform message passing across graph edges to update node states.\",\n    \"A valid contract needs offer, acceptance, and valid consideration.\"\n]\ndummy_target_docs   = dummy_preds   # simulate perfect grounding\ndummy_contam_docs   = [\"The stock market fell 2% today due to inflation concerns.\"] * 3\n\n# FIXED: Now actively executing and testing your BERTScore implementation on compile\nbertscore_result = compute_bertscore(dummy_preds, dummy_refs)\nrouge_result  = compute_rouge(dummy_preds, dummy_refs)\ncontam_result = compute_contamination_severity(dummy_preds, dummy_contam_docs)\nsgi_result    = compute_sgi_batch(dummy_preds, dummy_target_docs, dummy_contam_docs)\n\nprint(f\"  BERTScore F1 Mean: {bertscore_result['f1_mean']:.3f}\")\nprint(f\"  ROUGE-1 F1:        {rouge_result['rouge1_f1']:.3f}\")\nprint(f\"  Contam severity:  {contam_result['severity_mean']:.3f}\")\nprint(f\"  SGI mean:         {sgi_result['sgi_mean']:.3f}\")\nprint(f\"  CTCB rate:        {sgi_result['ctcb_rate']:.1%}\")\nprint(\"All metric functions working correctly.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-17T04:26:17.738766Z","iopub.execute_input":"2026-06-17T04:26:17.739141Z","iopub.status.idle":"2026-06-17T04:26:27.040557Z","shell.execute_reply.started":"2026-06-17T04:26:17.739111Z","shell.execute_reply":"2026-06-17T04:26:27.039382Z"}},"outputs":[{"name":"stdout","text":"Loading SBERT model for semantic metrics...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"modules.json:   0%|          | 0.00/349 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c7a695df2642497ea165a15fb29347c8"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config_sentence_transformers.json:   0%|          | 0.00/116 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"v